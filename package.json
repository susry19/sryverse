{
  "name": "sryverse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "skillmatch-x:sync": "node scripts/skillmatch-x/sync-voice-engine.mjs ../skillmatch-ai && ${PYTHON:-python3} scripts/skillmatch-x/precompute_matches.py --skillmatch ../skillmatch-ai && ${PYTHON:-python3} scripts/skillmatch-x/export_assistant_data.py --skillmatch ../skillmatch-ai",
    "skillmatch-x:verify": "node scripts/skillmatch-x/verify-scores.mjs && node scripts/skillmatch-x/verify-voice.mjs && node scripts/skillmatch-x/verify-assistant.mjs ../skillmatch-ai",
    "build:skillmatch-preview": "vite build --config vite.preview.config.js"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "gsap": "^3.12.2",
    "lenis": "^1.1.5",
    "pyodide": "^0.27.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.150.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.8"
  }
}
